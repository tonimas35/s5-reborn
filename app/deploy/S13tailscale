#!/bin/sh
# Acceso remoto con Tailscale. Copiar a /etc/init/S13tailscale
# Binarios y estado en /mnt/data/tailscale (se conservan aunque se reinstale el firmware).

load() {
    echo "starting tailscale"
    mkdir -p /var/run/tailscale
    start-stop-daemon -S -b -q -m -p /var/run/tailscaled-loop.pid -x /bin/sh -- /mnt/data/tailscale/run.sh
}

unload() {
    echo "stopping tailscale"
    start-stop-daemon -K -q -p /var/run/tailscaled-loop.pid
    killall tailscaled 2>/dev/null
}

case "$1" in
    start) load ;;
    stop) unload ;;
    restart) unload; sleep 1; load ;;
    *) echo "$0 <start/stop/restart>" ;;
esac
