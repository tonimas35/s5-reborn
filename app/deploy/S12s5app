#!/bin/sh
# Arranque de la app de s5-reborn (puerto 8080). Copiar a /etc/init/S12s5app

load() {
    echo "starting s5app"
    start-stop-daemon -S -b -q -m -p /var/run/s5app.pid -x /bin/sh -- /mnt/data/s5app/run.sh
}

unload() {
    echo "stopping s5app"
    start-stop-daemon -K -q -p /var/run/s5app.pid
    killall s5app 2>/dev/null
}

case "$1" in
    start) load ;;
    stop) unload ;;
    restart) unload; sleep 1; load ;;
    *) echo "$0 <start/stop/restart>" ;;
esac
